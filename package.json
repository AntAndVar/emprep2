{
  "name": "entry-onboarding-practice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"node scripts/python.mjs server/server.py\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node scripts/python.mjs server/server.py",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/python.mjs -m unittest discover -s server -p test_*.py && vitest run src/lib",
    "test:practice": "vitest run src/practice/wizard.exercise.test.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.49.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@vitejs/plugin-vue": "5.2.4",
    "concurrently": "9.2.4",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
